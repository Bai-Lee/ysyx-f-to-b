<?xml version='1.0' encoding='UTF-8'?>
<project source="4.0.0" version="1.0">
  <lib name="0" desc="#Wiring" />
  <lib name="1" desc="#Gates" />
  <lib name="2" desc="#Plexers" />
  <lib name="3" desc="#Arithmetic" />
  <lib name="4" desc="#Memory" />
  <lib name="5" desc="#I/O" />
  <lib name="8" desc="#Base" />
  <main name="tutorial_gui" />
  <options>
    <a name="simlimit" val="2000" />
  </options>
  <toolbar>
    <tool lib="8" name="Poke Tool" />
    <tool lib="8" name="Edit Tool" />
    <tool lib="8" name="Wiring Tool" />
    <tool lib="8" name="Text Tool" />
    <tool lib="0" name="Pin" />
    <tool lib="1" name="NOT Gate" />
    <tool lib="1" name="AND Gate" />
    <tool lib="1" name="OR Gate" />
  </toolbar>
  <circuit name="tutorial_gui">
    <a name="appearance" val="classic" />
    <comp loc="(100,100)" name="Pin" lib="0">
      <a name="label" val="X" />
      <a name="type" val="input" />
    </comp>
    <comp loc="(100,300)" name="Pin" lib="0">
      <a name="label" val="Y" />
      <a name="type" val="input" />
    </comp>
    <comp loc="(650,200)" name="Pin" lib="0">
      <a name="label" val="Z" />
      <a name="type" val="output" />
      <a name="facing" val="west" />
    </comp>
    <comp loc="(250,100)" name="NOT Gate" lib="1" />
    <comp loc="(250,300)" name="NOT Gate" lib="1" />
    <comp loc="(400,140)" name="AND Gate" lib="1">
      <a name="inputs" val="2" />
    </comp>
    <comp loc="(400,260)" name="AND Gate" lib="1">
      <a name="inputs" val="2" />
    </comp>
    <comp loc="(550,200)" name="OR Gate" lib="1">
      <a name="inputs" val="2" />
    </comp>
    <wire from="(100,100)" to="(150,100)" />
    <wire from="(150,100)" to="(220,100)" />
    <wire from="(150,100)" to="(150,120)" />
    <wire from="(150,120)" to="(350,120)" />
    <wire from="(250,100)" to="(280,100)" />
    <wire from="(280,100)" to="(280,240)" />
    <wire from="(280,240)" to="(350,240)" />
    <wire from="(100,300)" to="(170,300)" />
    <wire from="(170,300)" to="(220,300)" />
    <wire from="(170,300)" to="(170,280)" />
    <wire from="(170,280)" to="(350,280)" />
    <wire from="(250,300)" to="(300,300)" />
    <wire from="(300,300)" to="(300,160)" />
    <wire from="(300,160)" to="(350,160)" />
    <wire from="(400,140)" to="(450,140)" />
    <wire from="(450,140)" to="(450,180)" />
    <wire from="(450,180)" to="(500,180)" />
    <wire from="(400,260)" to="(470,260)" />
    <wire from="(470,260)" to="(470,220)" />
    <wire from="(470,220)" to="(500,220)" />
    <wire from="(550,200)" to="(650,200)" />
  </circuit>
</project>