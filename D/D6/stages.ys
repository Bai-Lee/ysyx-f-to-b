show -format svg -prefix /workspace/projects/ysyx_f_to_b/D/D6/results/read counter
proc
write_rtlil /workspace/projects/ysyx_f_to_b/D/D6/results/proc.il
show -format svg -prefix /workspace/projects/ysyx_f_to_b/D/D6/results/proc counter
write_json /workspace/projects/ysyx_f_to_b/D/D6/results/proc.json
opt
write_rtlil /workspace/projects/ysyx_f_to_b/D/D6/results/opt.il
show -format svg -prefix /workspace/projects/ysyx_f_to_b/D/D6/results/opt counter
write_json /workspace/projects/ysyx_f_to_b/D/D6/results/opt.json
techmap; splitnets -ports; opt -full
write_rtlil /workspace/projects/ysyx_f_to_b/D/D6/results/techmap.il
show -format svg -prefix /workspace/projects/ysyx_f_to_b/D/D6/results/techmap counter
