dfflibmap -liberty /workspace/projects/ysyx_f_to_b/D/D6/cell.lib; read_liberty -lib /workspace/projects/ysyx_f_to_b/D/D6/cell.lib
write_rtlil /workspace/projects/ysyx_f_to_b/D/D6/results/dfflibmap.il
show -format svg -prefix /workspace/projects/ysyx_f_to_b/D/D6/results/dfflibmap counter
write_json /workspace/projects/ysyx_f_to_b/D/D6/results/dfflibmap.json
abc -liberty /workspace/projects/ysyx_f_to_b/D/D6/cell.lib; clean
